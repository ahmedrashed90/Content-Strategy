{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "site",
    "ignore": ["firebase.json", "firestore.rules", "**/.*", "**/node_modules/**", "scripts/**", "README.md"],
    "headers": [
      {"source": "**/*.js", "headers": [{"key": "Cache-Control", "value": "public, max-age=300"}]},
      {"source": "/index.html", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}
    ]
  }
}
